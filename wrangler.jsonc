// The kids' front end on Cloudflare: https://coco.coachkrispel.com. Files come straight from docs/; only the
// recordings go through worker/range.js (byte ranges for Safari). Deploy: node build-pages.js && npx wrangler deploy.
// GitHub Pages keeps serving the same docs/ at the old address (it shows the "we moved" screen there).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-with-coco",
  "compatibility_date": "2026-10-23",
  "main": "worker/range.js",
  "assets": { "directory": "docs", "binding": "ASSETS", "run_worker_first": ["/api", "/missions/audio/*", "/talk/audio/*", "/nest/audio/*", "/nest/sounds/*", "/say/*"] },
  // /api: the server Durable Object of the coco-api Worker (worker/api, specs/cloudflare.md). A DO call here costs one
  // Worker request, a service binding would cost two of the free plan's 100,000 a day.
  "durable_objects": { "bindings": [{ "name": "COCO", "class_name": "CocoServer", "script_name": "coco-api" }] },
  "vars": { "LOCATION_HINT": "eeur" },
  "routes": [{ "pattern": "coco.coachkrispel.com", "custom_domain": true }],
  "workers_dev": true
}
